From 32198774d40f60ff9f730d635808f489097349b3 Mon Sep 17 00:00:00 2001
From: Ariel Peretz <benoit.casse@gmail.com>
Date: Sat, 17 Oct 2026 12:00:00 +0200
Subject: [PATCH 3/3] smp: propagate the degradation to the global CPU counter
To: bug-hurd@gnu.org

The previous patch degrades to BSP-only, but it only fixes the local
ncpus variable in start_other_cpus().  smp_get_numcpus() keeps returning
the APIC-reported count, so the scheduler, the pmap IPIs and ddb keep
addressing application processors that were never brought up, and the
boot hangs again later on an unacknowledged IPI.

Call smp_set_numcpus() with the number of CPUs that really started, so
that the rest of the kernel only ever refers to live CPUs.
---
 i386/i386/mp_desc.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/i386/i386/mp_desc.c b/i386/i386/mp_desc.c
index aa40c197..a206d39e 100644
--- a/i386/i386/mp_desc.c
+++ b/i386/i386/mp_desc.c
@@ -332,6 +332,7 @@ start_other_cpus(void)
 	if (smp_startup_cpus(apic_get_current_cpu(), apboot_addr) != 0) {
 		printf("SMP: AP startup failed, continuing with BSP only\n");
 		ncpus = 1;
+		smp_set_numcpus(1);
 	} else {
 		unsigned started = 0;
 		for (cpu = 1; cpu < ncpus; cpu++) {
@@ -348,8 +349,11 @@ start_other_cpus(void)
 			}
 			started++;
 		}
-		/* Only rely on contiguously started APs below. */
+		/* Only rely on contiguously started APs below, and tell the
+		 * rest of the kernel (scheduler, pmap IPIs, ddb) so a dead
+		 * AP never receives IPIs. */
 		ncpus = started + 1;
+		smp_set_numcpus(ncpus);
 	}
 	printf("BSP: Completed SMP init\n");
 
