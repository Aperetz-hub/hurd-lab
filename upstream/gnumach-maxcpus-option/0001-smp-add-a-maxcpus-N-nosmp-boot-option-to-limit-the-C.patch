From 6d5fcd9c08a53b573e86aea3fbbcf2f61fe31f49 Mon Sep 17 00:00:00 2001
From: Ariel Peretz <benoit.casse@gmail.com>
Date: Sat, 17 Oct 2026 10:52:57 +0200
Subject: [PATCH] smp: add a maxcpus=N / nosmp boot option to limit the CPUs
 used
To: bug-hurd@gnu.org

GNU Mach starts as many application processors as the firmware (or QEMU)
advertises, and there is no way to ask for fewer once the machine has been
declared SMP.  On the amd64 port the SMP paths are still experimental, so a
user who runs QEMU with -smp 2 (or more) has no way to fall back to a
single-CPU boot.

Add two multiboot command line options:

  nosmp      start at most one CPU;
  maxcpus=N  start at most N CPUs (N >= 1).

smp_data_init() clamps the APIC-reported CPU count to the requested limit
before smp_set_numcpus() is called, so the rest of the kernel (scheduler,
pmap IPIs, ddb) only ever sees the CPUs that were really brought up.  When
no option is given the behaviour is unchanged.

Both options are useful beyond this fork: they let a distribution ship an
SMP-capable kernel while still letting the user boot a known-good
single-CPU configuration on a machine whose SMP path misbehaves.
---
 i386/i386/smp.c | 40 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/i386/i386/smp.c b/i386/i386/smp.c
index 6b610020..b1b37e34 100644
--- a/i386/i386/smp.c
+++ b/i386/i386/smp.c
@@ -33,6 +33,38 @@
 
 #include <kern/smp.h>
 
+extern char *kernel_cmdline;
+
+/*
+ * smp_maxcpus_from_cmdline: kernel (multiboot) command line option limiting
+ * the number of CPUs the kernel uses:
+ *   nosmp     -> at most 1 CPU
+ *   maxcpus=N -> at most N CPUs (N >= 1)
+ * Returns 0 when no limit is requested (default: all CPUs).  This makes it
+ * possible to boot a "-smp N" host with a single usable CPU, as a way to
+ * work around the SMP races that are not resolved yet.
+ */
+static uint8_t
+smp_maxcpus_from_cmdline(void)
+{
+    const char *p;
+    unsigned n;
+
+    if (strstr(kernel_cmdline, "nosmp") != NULL)
+        return 1;
+
+    p = strstr(kernel_cmdline, "maxcpus=");
+    if (p != NULL) {
+        n = 0;
+        p += sizeof("maxcpus=") - 1;
+        while (*p >= '0' && *p <= '9')
+            n = n * 10 + (unsigned)(*p++ - '0');
+        if (n >= 1)
+            return (uint8_t) n;
+    }
+    return 0;
+}
+
 /*
  * smp_data_init: initialize smp_data structure
  * Must be called after smp_init(), once all APIC structures
@@ -41,6 +73,14 @@
 static void smp_data_init(void)
 {
     uint8_t numcpus = apic_get_numcpus();
+    uint8_t maxcpus = smp_maxcpus_from_cmdline();
+
+    if (maxcpus != 0 && maxcpus < numcpus) {
+        printf("SMP: maxcpus=%u, limiting the kernel to %u CPUs out of %u\n",
+               maxcpus, maxcpus, numcpus);
+        numcpus = maxcpus;
+    }
+
     smp_set_numcpus(numcpus);
 
     for(int i = 0; i < numcpus; i++){
-- 
